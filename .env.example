# TOUPRE environment variables
# Copy to .env.local for local Vite development.
# Set the same keys in Vercel / Capacitor build environments.

# Required — Supabase project
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Client feature gates (never put secrets in VITE_*)
# VITE_MONCASH_ENABLED=true     # enable MonCash redirect UI after Edge secrets are set
# VITE_SENTRY_DSN=              # optional error monitoring DSN
# VITE_APP_VERSION=1.0.0

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# SUPABASE_SERVICE_ROLE_KEY=   # already provided to functions by Supabase
# ALLOWED_ORIGINS=https://toupre.com,https://www.toupre.com,http://localhost:5173
# ALLOW_DEV_OTP=false          # never true in production
# APP_URL=https://toupre.com
# PAYMENT_RETURN_URL=https://toupre.com

# MonCash (Edge only — never VITE_*)
# MONCASH_CLIENT_ID=
# MONCASH_CLIENT_SECRET=
# MONCASH_MODE=sandbox          # sandbox | live
# MONCASH_WEBHOOK_SECRET=       # required for POST webhooks
# MONCASH_ALLOW_UNSIGNED_CAPTURE=false  # never true in production

# Other providers (architecture only until wired)
# NATCASH_API_KEY=
# NATCASH_WEBHOOK_SECRET=
# CARD_PROVIDER_SECRET_KEY=
# CARD_PROVIDER_WEBHOOK_SECRET=
